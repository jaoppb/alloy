{
	"config": {
		"default": true,
		"MD007": false,
		"MD010": false,
		"MD013": {
			"line_length": 120,
			"code_blocks": false,
			"tables": false,
			"headings": false
		},
		"MD024": {
			"siblings_only": true
		},
		"MD033": true
	},
	"ignores": [
		"node_modules",
		"target",
		".git",
		".agents",
		".cursor",
		"Cargo.lock",
		"pnpm-lock.yaml"
	]
}
